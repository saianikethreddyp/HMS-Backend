DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=hms_sid
CSRF_COOKIE_NAME=hms_csrf
SESSION_TTL_HOURS=12

# Used only by prisma/seed.ts to create the first admin user in dev.
# Login has no password -- this is a single-portal, admin-only internal tool.
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_NAME="Front Desk Admin"
