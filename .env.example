DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# A SEPARATE database (e.g. a Neon branch made just for testing), never the
# same as DATABASE_URL above. Integration tests delete every row in every
# table before/after each run -- tests/setup-env.ts refuses to run at all
# unless this points somewhere different from the real app database.
TEST_DATABASE_URL="postgresql://user:password@host/test_db?sslmode=require"
# Prisma Migrate needs a direct (non-pooled) connection for its advisory
# lock -- on Neon this is the same connection string without "-pooler" in
# the hostname. Only used for migrations, never at app runtime.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=hms_sid
CSRF_COOKIE_NAME=hms_csrf
SESSION_TTL_HOURS=12

# The server auto-creates this admin account on startup if the database has
# no staff at all yet (see src/bootstrap.ts), and prisma/seed.ts uses the
# same defaults if run manually. Both default to admin/Administrator even if
# unset. Login has no password -- this is a single-portal, admin-only
# internal tool.
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_NAME="Front Desk Admin"
